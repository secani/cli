{
  "name": "secani",
  "version": "0.1.1",
  "description": "Work with your Secani ISMS from the terminal: risks, tasks, findings, controls and incidents, for people, scripts and coding agents.",
  "keywords": [
    "secani",
    "isms",
    "iso27001",
    "grc",
    "compliance",
    "risk-management",
    "mcp",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Secani (https://secani.com)",
  "homepage": "https://secani.com/docs/cli",
  "bugs": {
    "url": "https://github.com/secani/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secani/cli.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "secani": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke:dist"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
